/* wz-724 professional dark control-console theme */
QMainWindow, QWidget#centralWidget {
    background: #07121b;
    color: #d7e5ee;
}

QWidget {
    font-family: "Microsoft YaHei UI";
    font-size: 13px;
}

QWidget#widget_top {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0c1b27, stop:0.55 #102433, stop:1 #0b1924);
    border-bottom: 1px solid #2c4658;
}

QLabel#label_2 {
    color: #f1f7fb;
    font-size: 16px;
    font-weight: 600;
    padding-left: 4px;
}

QLabel#topClock {
    color: #9fc1d4;
    background: rgba(6, 16, 24, 120);
    border: 1px solid #294354;
    border-radius: 7px;
    padding: 5px 11px;
    font-family: "Consolas";
    font-size: 12px;
}

QPushButton[role="topTool"] {
    min-width: 32px;
    min-height: 30px;
    max-width: 32px;
    max-height: 30px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
QPushButton[role="topTool"]:hover {
    background: #1a3445;
    border-color: #42677d;
}
QPushButton[role="topTool"]:pressed { background: #102633; }
QPushButton#pushButton_close:hover { background: #702c36; border-color: #bc5964; }

QPushButton[role="modeDive"], QPushButton[role="modeClean"] {
    min-height: 28px;
    padding: 0 14px;
    border-radius: 6px;
    font-weight: 600;
}
QPushButton[role="modeDive"] {
    color: #77d8ee;
    background: rgba(20, 80, 102, 120);
    border: 1px solid #267a95;
}
QPushButton[role="modeDive"]:hover { background: #175d76; }
QPushButton[role="modeClean"] {
    color: #7ee2b8;
    background: rgba(23, 91, 67, 120);
    border: 1px solid #2a8163;
}
QPushButton[role="modeClean"]:hover { background: #1d694f; }

QWidget#widget_cameraPanel, QWidget#widget_ctrlPanel { background: #07121b; }

QWidget#widget_camera_0, QWidget#widget_camera_back_1 {
    background: #03090e;
    border: 1px solid #294454;
    border-radius: 8px;
}

QWidget#widget, QWidget#widget_leftCtrlPanel, QWidget#widget_rightCtrlPanel,
WidgetPFD#widgetPFD, QWidget#widget_4 {
    background: #0b1923;
    border: 1px solid #253d4c;
    border-radius: 8px;
}

QWidget#telemetryPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0d202c, stop:1 #091720);
    border: 1px solid #2d4a5b;
    border-radius: 8px;
}

QLabel[role="sectionTitle"] {
    color: #b8d2df;
    background: transparent;
    border: none;
    border-bottom: 1px solid #274252;
    min-height: 24px;
    padding: 0 3px 4px 3px;
    font-size: 12px;
    font-weight: 600;
}

QWidget[metricCard="true"] {
    background: rgba(10, 29, 40, 210);
    border: 1px solid #294b5e;
    border-radius: 7px;
}
QWidget[metricCard="true"]:hover {
    background: rgba(14, 39, 52, 230);
    border-color: #3a6c83;
}
QLabel[role="metricTitle"] {
    color: #789caf;
    background: transparent;
    border: none;
    font-size: 11px;
    font-weight: 600;
}
QLabel[role="metricValue"] {
    color: #dff7ff;
    background: transparent;
    border: none;
    font-family: "Consolas";
    font-size: 22px;
    font-weight: 600;
}
QLabel[role="metricUnit"] {
    color: #7193a5;
    background: transparent;
    border: none;
    padding-bottom: 3px;
    font-family: "Consolas";
    font-size: 10px;
}

QPushButton[role="gimbal"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a3343, stop:1 #102531);
    border: 1px solid #345469;
    border-radius: 6px;
    min-width: 29px;
    min-height: 29px;
}
QPushButton[role="gimbal"]:hover {
    background: #21536b;
    border-color: #5b9ab8;
}
QPushButton[role="gimbal"]:pressed { background: #0d87aa; }

QLabel#label_leftLight, QLabel#label_rightLight {
    color: #a9c1cf;
    font-weight: 600;
    padding: 3px;
}

QComboBox {
    color: #d9ebf3;
    background: #102633;
    border: 1px solid #356078;
    border-radius: 6px;
    min-height: 28px;
    padding: 1px 28px 1px 10px;
    font-weight: 600;
}
QComboBox:hover { border-color: #4f8ca9; background: #143042; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    color: #d9ebf3;
    background: #102633;
    border: 1px solid #3a657b;
    selection-background-color: #196f8e;
    outline: 0;
}

QSlider::groove:vertical {
    background: #142a37;
    width: 8px;
    border-radius: 4px;
}
QSlider::sub-page:vertical { background: #142a37; border-radius: 4px; }
QSlider::add-page:vertical { background: #1686aa; border-radius: 4px; }
QSlider::handle:vertical {
    background: #d9f3fb;
    border: 2px solid #35a9cb;
    width: 18px;
    height: 18px;
    margin: -5px -6px;
    border-radius: 9px;
}
QSlider::handle:vertical:hover { background: white; border-color: #6bd5ed; }

QStatusBar {
    background: #091720;
    color: #9fb8c6;
    border-top: 1px solid #263e4d;
    min-height: 30px;
}
QStatusBar::item { border: none; }
QSizeGrip { width: 0; height: 0; }

QLabel[statusBadge="true"] {
    border-radius: 7px;
    padding: 3px 10px;
    margin: 2px 3px;
    font-weight: 600;
}
QLabel[statusBadge="true"][state="ok"] {
    color: #8ce7c0; background: #123c31; border: 1px solid #286b57;
}
QLabel[statusBadge="true"][state="danger"] {
    color: #ff9ba5; background: #47232a; border: 1px solid #7d3c47;
}
QLabel[statusBadge="true"][state="warning"] {
    color: #ffd58a; background: #493a1f; border: 1px solid #80652c;
}
QLabel[statusBadge="true"][state="info"] {
    color: #8fdcf0; background: #123746; border: 1px solid #28627a;
}
QLabel#attitudeBadge {
    color: #9ee8f6;
    background: #102d3a;
    border: 1px solid #285b6e;
    border-radius: 7px;
    padding: 3px 11px;
    margin: 2px 3px;
    font-family: "Consolas";
    font-weight: 600;
}
QLabel#systemStatusText { color: #adc2cd; padding: 0 10px; }

QToolTip {
    color: #e4f1f6;
    background: #102633;
    border: 1px solid #42677d;
    border-radius: 4px;
    padding: 5px;
}

/* Four-row ROV operations dashboard */
QWidget#dashboardTopRow, QWidget#dashboardVisualRow, QWidget#dashboardControlRow {
    background: #06141d;
}

QWidget[dashboardPanel="true"], QWidget[controlCell="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0b2632, stop:1 #071923);
    border: 1px solid #21677a;
    border-radius: 9px;
}

QWidget#frontCameraFrame, QWidget#modelFrame, QWidget#depthFrame,
QWidget#rearCameraFrame {
    border: 2px solid #24899c;
}

QLabel[role="dashboardTitle"] {
    color: #d4eef4;
    background: transparent;
    border: none;
    border-bottom: 1px solid #1e5262;
    min-height: 20px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 4px 3px 4px;
}

QLabel[role="controlTitle"] {
    color: #9cc9d5;
    background: transparent;
    border: none;
    font-size: 11px;
    font-weight: 600;
}

QLabel#connectionStateValue {
    color: #ffbd59;
    background: #071d27;
    border: 1px solid #276477;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 600;
}
QLabel#connectionStateValue[state="ok"] { color: #68ef9e; border-color: #308c62; }
QLabel#connectionStateValue[state="danger"] { color: #ff7e88; border-color: #963d49; }
QLabel#connectionStateValue[state="warning"] { color: #ffd071; border-color: #88692c; }
QLabel#connectionAddressValue {
    color: #74d6e8;
    background: transparent;
    border: none;
    font-family: "Consolas";
    font-size: 13px;
    font-weight: 600;
}

QLabel#dashboardClock {
    color: #d7f2f7;
    background: transparent;
    border: none;
    font-family: "Consolas";
    font-size: 16px;
    font-weight: 600;
}

QPushButton[role="dashboardTool"] {
    color: #bfe9f1;
    background: #0c2b38;
    border: 1px solid #2f8598;
    border-radius: 7px;
    min-height: 48px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton[role="dashboardTool"]:hover {
    color: #04202a;
    background: #38d3e6;
    border-color: #81edf7;
}
QPushButton[role="dashboardMiniTool"] {
    color: #92bdc8;
    background: transparent;
    border: 1px solid #285869;
    border-radius: 5px;
    min-width: 25px;
    max-width: 25px;
    min-height: 23px;
    max-height: 23px;
    font-size: 17px;
    font-weight: 600;
}
QPushButton[role="dashboardMiniTool"]:hover {
    color: white;
    background: #a8323c;
    border-color: #e2606b;
}

QWidget#emergencyCell {
    background: #071923;
    border: 1px solid #4b5f48;
    border-radius: 9px;
}
QPushButton#emergencyStopButton {
    color: white;
    background: qradialgradient(cx:0.45, cy:0.35, radius:0.72,
                                stop:0 #ff5c5c, stop:0.58 #dc252b, stop:1 #7c1118);
    border: 7px solid #e8c629;
    border-radius: 76px;
    min-width: 140px;
    max-width: 140px;
    min-height: 140px;
    max-height: 140px;
    font-size: 22px;
    font-weight: 700;
}
QPushButton#emergencyStopButton:hover { border-color: #fff06d; }
QPushButton#emergencyStopButton:pressed,
QPushButton#emergencyStopButton:checked {
    background: #9d1018;
    border-color: #ffdf33;
}

QWidget#dashboardControlRow QSlider::groove:vertical {
    background: #123440;
    width: 9px;
    border-radius: 4px;
}
QWidget#dashboardControlRow QSlider::add-page:vertical {
    background: #20c9df;
    border-radius: 4px;
}
QWidget#dashboardControlRow QSlider::handle:vertical {
    background: #e6fbff;
    border: 2px solid #4bd8ea;
    width: 19px;
    height: 19px;
    margin: -5px -6px;
    border-radius: 10px;
}
